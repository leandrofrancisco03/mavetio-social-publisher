{
  "name": "mavetio-social-publisher",
  "version": "1.0.0",
  "description": "Mavetio Social Publisher: gestión de vídeos mediante Postiz",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "dev": "vite dev --host 127.0.0.1 --port 3001",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "vinext check",
    "preview": "wrangler dev --config dist/server/wrangler.json --port 3001",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry": "wrangler deploy --config dist/server/wrangler.json --dry-run",
    "db:local": "wrangler d1 migrations apply mavetio-social-publisher --local",
    "predeploy": "node scripts/predeploy.mjs",
    "format": "prettier --write app components lib tests scripts docs *.ts *.json *.jsonc README.md"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@vinext/cloudflare": "^1.3.4",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vinext": "^1.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "prettier": "^3.10.1",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "private": true,
  "overrides": {
    "fflate": "0.7.5"
  },
  "engines": {
    "node": ">=24"
  }
}
